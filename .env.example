# Local development uses the Flask API and the existing SQLite database.
# Remove VITE_API_MODE or set it to an empty value to use Supabase/demo mode instead.
# Never use a Supabase service_role key in frontend environment variables.
VITE_API_MODE="flask"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Set a long, unique secret. Required to register admins from the login page.
FLASK_ADMIN_REGISTRATION_CODE=""
